<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.irr00_group_project.controller.LossScreenController"
           styleClass="popup-bg">
    <VBox alignment="CENTER" spacing="30" styleClass="popup-panel">
        <Label text="You Lost!" styleClass="popup-title"/>
        <Label text="Better luck next time!" styleClass="popup-subtitle"/>
        <VBox spacing="15" alignment="CENTER">
            <Button text="Restart" fx:id="restartButton" styleClass="popup-button"/>
            <Button text="Level Selection" fx:id="levelSelectButton" styleClass="popup-button" onAction="#handleLevelSelectionButton"/>
        </VBox>
    </VBox>
</StackPane>
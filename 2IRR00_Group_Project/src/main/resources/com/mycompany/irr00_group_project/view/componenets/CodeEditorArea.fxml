<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="10" alignment="TOP_LEFT" prefWidth="600" prefHeight="400">
    
    <!-- Button container with the run button -->
    <HBox alignment="TOP_LEFT">
        <Button fx:id="runButton"
                text="Run"
                maxWidth="100"
                alignment="CENTER_LEFT" />
    </HBox>

    <!-- Code editor (text area) -->
    <TextArea fx:id="codeEditor"
              promptText="Write your code here..."
              prefHeight="350"
              wrapText="true" />

</VBox>
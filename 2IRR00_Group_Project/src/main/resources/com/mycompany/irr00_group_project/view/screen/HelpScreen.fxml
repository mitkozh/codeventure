<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane fx:id="rootPane" styleClass="helpScreen-bg" xmlns:fx="http://javafx.com/fxml" fx:controller="com.mycompany.irr00_group_project.controller.HelpController">
    <VBox fx:id="helpPanel" styleClass="helpScreen-panel" maxWidth="1100" maxHeight="750" alignment="TOP_CENTER" spacing="20">
        <padding>
            <Insets bottom="30.0" left="20.0" right="20.0" top="20.0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="helpScreen-header">
            <HBox HBox.hgrow="ALWAYS" alignment="CENTER">
                <Label text="HELP" styleClass="helpScreen-title"/>
            </HBox>
            <Button fx:id="closeButton" text="X" styleClass="custom-button, close-button" onAction="#backToMenu"/>
        </HBox>

        <!-- Main content box -->
        <VBox styleClass="content-inner-box" VBox.vgrow="ALWAYS" alignment="TOP_CENTER" spacing="15">
            <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <HBox spacing="40" alignment="TOP_CENTER" styleClass="helpScreen-columns">
                    <padding>
                        <Insets top="20" bottom="20" left="30" right="30"/>
                    </padding>

                    <!-- Left Column -->
                    <VBox alignment="TOP_LEFT" spacing="15" prefWidth="450">
                        <Label text="GAME MECHANICS" styleClass="section-title"/>

                        <VBox spacing="8">
                            <Label text="CODE EDITOR" styleClass="subsection-title"/>
                            <Label text="• Write code to move the Robot" styleClass="help-text"/>
                            <Label text="• Use commands on the robot's turn" styleClass="help-text"/>
                            <Label text="• The goal is to reach the Terminal" styleClass="help-text"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="TILE TYPES" styleClass="subsection-title"/>
                            <Label text="FLOOR: Safe walking area" styleClass="help-text"/>
                            <ImageView fx:id="floorTileImage" fitWidth="50" fitHeight="50">
                                <image>
                                    <Image url="@../../assets/images/tiles/normal_tile.png"/>
                                </image>
                            </ImageView>

                            <Label text="HAZARD: Dangerous area to avoid" styleClass="help-text"/>
                            <ImageView fx:id="obstacleTileImage" fitWidth="50" fitHeight="50">
                                <image>
                                    <Image url="@../../assets/images/tiles/obstacle_tile.png"/>
                                </image>
                            </ImageView>

                            <Label text="TERMINAL: Goal destination" styleClass="help-text"/>
                            <ImageView fx:id="endTileImage" fitWidth="50" fitHeight="50">
                                <image>
                                    <Image url="@../../assets/images/tiles/end_tile.png"/>
                                </image>
                            </ImageView>
                        </VBox>
                    </VBox>

                    <!-- Right Column -->
                    <VBox alignment="TOP_LEFT" spacing="15" prefWidth="450">
                        <Label text="CODE EXAMPLES" styleClass="section-title"/>

                        <VBox spacing="10">
                            <Label text="moveForward();" styleClass="code-text"/>
                            <Label text="Basic movement command" styleClass="code-description"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="turnLeft();" styleClass="code-text"/>
                            <Label text="Command for changing direction to left" styleClass="code-description"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="turnRight();" styleClass="code-text"/>
                            <Label text="Command for changing direction to right" styleClass="code-description"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="if (safe()) {\n    move();\n}" styleClass="code-text"/>
                            <Label text="Conditional movement" styleClass="code-description"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="while (true) {\n    move();\n}" styleClass="code-text"/>
                            <Label text="Loop movement" styleClass="code-description"/>
                        </VBox>
                    </VBox>
                </HBox>
            </ScrollPane>

            <!-- Main Menu Button -->
            <Button fx:id="backToMenuButton" onAction="#backToMenu" styleClass="custom-button, back-to-menu-button" text="MAIN MENU"/>
        </VBox>
    </VBox>
</StackPane>
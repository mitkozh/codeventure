<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane" styleClass="levelSelection-bg" xmlns:fx="http://javafx.com/fxml" fx:controller="com.mycompany.irr00_group_project.controller.LevelSelectionController">
    <VBox fx:id="levelSelectionPanel" styleClass="levelSelection-panel" maxWidth="1150" maxHeight="850" alignment="TOP_CENTER" spacing="20.0">
        <padding>
            <Insets bottom="30.0" left="20.0" right="20.0" top="20.0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="levelSelection-header">
            <HBox HBox.hgrow="ALWAYS" alignment="CENTER">
                <Label text="LEVEL SELECTION" styleClass="levelSelection-title"/>
            </HBox>
        </HBox>

        <!-- Content Section -->
        <VBox styleClass="content-inner-box" VBox.vgrow="ALWAYS" alignment="TOP_CENTER" spacing="10">
            <padding>
                <Insets top="20" bottom="20" left="20" right="20"/>
            </padding>

            <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" currentPageIndex="0" VBox.vgrow="ALWAYS"/>

            <!-- Main Menu Button -->
            <Button fx:id="backToMenuButton" onAction="#backToMenu" styleClass="custom-button, back-to-menu-button" text="MAIN MENU"/>
        </VBox>
    </VBox>
</StackPane>

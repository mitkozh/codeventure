<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane fx:id="rootPane" styleClass="helpScreen-bg" xmlns:fx="http://javafx.com/fxml" fx:controller="com.mycompany.irr00_group_project.controller.HelpController">
    <VBox fx:id="helpPanel" styleClass="helpScreen-panel" maxWidth="1100" maxHeight="750" alignment="TOP_CENTER" spacing="20">
        <padding>
            <Insets bottom="30.0" left="20.0" right="20.0" top="20.0"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="helpScreen-header">
            <HBox HBox.hgrow="ALWAYS" alignment="CENTER">
                <Label text="HELP" styleClass="helpScreen-title"/>
            </HBox>
            <Button fx:id="closeButton" text="X" styleClass="custom-button, close-button" onAction="#backToMenu"/>
        </HBox>

        <!-- Main content box -->
        <VBox styleClass="content-inner-box" VBox.vgrow="ALWAYS" alignment="TOP_CENTER" spacing="15">
            <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <HBox spacing="40" alignment="TOP_CENTER" styleClass="helpScreen-columns">
                    <padding>
                        <Insets top="20" bottom="20" left="30" right="30"/>
                    </padding>

                    <!-- Left Column -->
                    <VBox alignment="TOP_LEFT" spacing="15" prefWidth="450">
                        <Label text="GAME MECHANICS" styleClass="section-title"/>

                        <VBox spacing="8">
                            <Label text="CODE EDITOR" styleClass="subsection-title"/>
                            <ImageView fx:id="codeEditorImage" fitWidth="350" fitHeight="250">
                                <image>
                                    <Image url="@../../assets/images/code_editor_pic.png"/>
                                </image>
                            </ImageView>
                            <Label text="• Write code here to move the Robot" styleClass="help-text"/>
                            <Label text="• Use commands to guide the robot to the goal" styleClass="help-text"/>
                            <Label text="• The goal is to reach the Terminal" styleClass="help-text"/>
                            <Label text="• Use Java syntax for the code" styleClass="help-text"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="TILE TYPES" styleClass="subsection-title"/>
                            <Label text="FLOOR: Safe walking area" styleClass="help-text"/>
                            <ImageView fx:id="floorTileImage" fitWidth="50" fitHeight="50">
                                <image>
                                    <Image url="@../../assets/images/tiles/normal_tile.png"/>
                                </image>
                            </ImageView>

                            <Label text="HAZARD: Dangerous area to avoid" styleClass="help-text"/>
                            <ImageView fx:id="obstacleTileImage" fitWidth="50" fitHeight="50">
                                <image>
                                    <Image url="@../../assets/images/tiles/obstacle_tile.png"/>
                                </image>
                            </ImageView>

                            <Label text="TERMINAL: Goal destination" styleClass="help-text"/>
                            <ImageView fx:id="endTileImage" fitWidth="50" fitHeight="50">
                                <image>
                                    <Image url="@../../assets/images/tiles/end_tile.png"/>
                                </image>
                            </ImageView>

                            <Label text="KEY: Objective" styleClass="help-text"/>
                            <ImageView fx:id="keyAnimation" fitWidth="50" fitHeight="50">
                                <image>
                                    <Image url="@../../assets/images/tiles/key-animation.gif"/>
                                </image>
                            </ImageView>

                            <Label text="DOOR: Opened" styleClass="help-text"/>
                            <ImageView fx:id="doorOpenedImage" fitWidth="50" fitHeight="50">
                                <image>
                                    <Image url="@../../assets/images/tiles/door_opened.png"/>
                                </image>
                            </ImageView>

                            <Label text="DOOR: Closed" styleClass="help-text"/>
                            <ImageView fx:id="doorClosedImage" fitWidth="50" fitHeight="50">
                                <image>
                                    <Image url="@../../assets/images/tiles/door_closed.png"/>
                                </image>
                            </ImageView>
                            <Label text="• The keys are needed to unlock the doors" styleClass="help-text"/>
                            <Label text="• You can't move through a door unless you have a key" styleClass="help-text"/>
                        </VBox>
                    </VBox>

                    <!-- Right Column -->
                    <VBox alignment="TOP_LEFT" spacing="15" prefWidth="450">
                        <Label text="CODE EXAMPLES" styleClass="section-title"/>

                        <VBox spacing="10">
                            <Label text="Basic movement command" styleClass="code-description"/>
                            <Label text="character.moveForward();" styleClass="code-text"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="Command for changing direction to left" styleClass="code-description"/>
                            <Label text="character.turnLeft();" styleClass="code-text"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="Command for changing direction to right" styleClass="code-description"/>
                            <Label text="character.turnRight();" styleClass="code-text"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="Conditional movement" styleClass="code-description"/>
                            <Label text="if (safe()) {&#10;    character.moveForward();&#10;}" styleClass="code-text"/>
                        </VBox>

                        <VBox spacing="10">
                            <Label text="Loop movement" styleClass="code-description"/>
                            <Label text="while (true) {&#10;    character.moveForward();&#10;}" styleClass="code-text"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="FEEDBACK SCREEN" styleClass="section-title"/>
                            <Label text="Positive feedback" styleClass="help-text"/>
                            <ImageView fx:id="positiveFeedbackImage" fitWidth="300" fitHeight="75">
                                <image>
                                    <Image url="@../../assets/images/sucess_feedback_screen.png"/>
                                </image>
                            </ImageView>

                            <Label text="Negative feedback" styleClass="help-text"/>
                            <ImageView fx:id="negativeFeedbackImage" fitWidth="300" fitHeight="75">
                                <image>
                                    <Image url="@../../assets/images/non-sucess_feedback_screen.png"/>
                                </image>
                            </ImageView>

                            <Label text="• Feedback shows step count and stars earned" styleClass="help-text"/>
                            <Label text="• Fewer steps earn higher star ratings" styleClass="help-text"/>
                        </VBox>
                    </VBox>
                </HBox>
            </ScrollPane>

            <!-- Main Menu Button -->
            <Button fx:id="backToMenuButton" onAction="#backToMenu" styleClass="custom-button, back-to-menu-button" text="MAIN MENU"/>
        </VBox>
    </VBox>
</StackPane>
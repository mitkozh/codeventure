<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootPane" styleClass="game-bg" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.mycompany.irr00_group_project.controller.GameScreenController">

    <BorderPane fx:id="gamePanel" styleClass="game-panel" maxWidth="1400" maxHeight="900">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>

        <center>
            <HBox spacing="20" VBox.vgrow="ALWAYS">
                <VBox HBox.hgrow="ALWAYS" minWidth="600">
                    <fx:include fx:id="gameGrid" source="../components/GameGridDisplay.fxml" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox spacing="15" HBox.hgrow="SOMETIMES" minWidth="400" maxWidth="500">
                    <Label fx:id="levelTitle" styleClass="level-title"/>
                    <fx:include fx:id="codeEditor" source="../components/CodeEditorArea.fxml" VBox.vgrow="ALWAYS"/>
                    <fx:include fx:id="consoleOutput" source="../components/ConsoleOutputArea.fxml" VBox.vgrow="SOMETIMES"/>
                    <VBox spacing="10" styleClass="right-panel-buttons-area">
                        <VBox spacing="8" alignment="CENTER">
                            <HBox spacing="8">
                                <Button fx:id="runCodeButton" text="RUN CODE" styleClass="custom-button, run-button"
                                        onAction="#runCode" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="stopExecutionButton" text="STOP EXECUTION" styleClass="custom-button, stop-button"
                                        onAction="#stopExecution" disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                            <HBox spacing="8">
                                <Button fx:id="resetLevelButton" text="RESET LEVEL" styleClass="custom-button, reset-button"
                                        onAction="#resetLevel" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="settingsButton" onAction="#onSettingsClick" styleClass="custom-button, settings-button" text="SETTINGS"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>
        </center>
    </BorderPane>
</StackPane>